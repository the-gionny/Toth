var NET_Toth_TypeError=fn(funcname,argnumber,expectedtype,id){
    if(typeof(id)!=expectedtype){throwError("argument["+argnumber+"] `"+funcname+"` must be "+expectedtype+", got "+typeof(id))}
}

\* Functions *\

var Remove_Control=fn(id){
    if(typeof(id)!="INTEGER"){throwError("argument[0] `Remove_Control` must be INTEGER, got "+typeof(id))}

    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){
        throwError("`Remove_Control` Invalid ID: The Control do not exist!")
    }else{
        callDLL(mydll,"RemoveControl","void",id);
    }
}

var Create_Form=fn(x,y,width,height,title){
    NET_Toth_TypeError("Create_Form",0,"INTEGER",x); NET_Toth_TypeError("Create_Form",1,"INTEGER",y);
    NET_Toth_TypeError("Create_Form",2,"INTEGER",width); NET_Toth_TypeError("Create_Form",3,"INTEGER",height); NET_Toth_TypeError("Create_Form",4,"STRING",title);
    callDLL(mydll,"CreateNewForm","void",x,y,width,height,title);
}

var Create_Button=fn(id){
    NET_Toth_TypeError("Create_Button",0,"INTEGER",id);
    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){
        var NET_Toth_Controls =: hashEdit(NET_Toth_Controls,toString(id),"Button");
        var NET_Toth_canclick =: hashEdit(NET_Toth_canclick,toString(id),true);
        callDLL(mydll,"CreateNewButton","void",id);
    }else{
        throwError("`Create_Button` a Control with the same ID already exists!")
    }
}
