var Set_BackColor=fn(id,color){
    NET_Toth_TypeError("Set_BackColor",0,"INTEGER",id); NET_Toth_TypeError("Set_BackColor",1,"ARRAY",color);
    if(typeof(color[0])!="INTEGER" || color[0]>255 || color[0]<0){throwError("`Set_BackColor` Invalid Colorcode: must be INTEGER between 0 and 255. got="+ color[0])}
    if(typeof(color[1])!="INTEGER" || color[1]>255 || color[1]<0){throwError("`Set_BackColor` Invalid Colorcode: must be INTEGER between 0 and 255. got="+ color[1])}
    if(typeof(color[2])!="INTEGER" || color[2]>255 || color[2]<0){throwError("`Set_BackColor` Invalid Colorcode: must be INTEGER between 0 and 255. got="+ color[2])}
    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){
        throwError("`Set_BackColor` Invalid ID: The Control do not exist!")
    }else{
        callDLL(mydll,"SetControlBackColor","void",id,color[0],color[1],color[2]);
    }
}
