var Items_Add=fn(id,item){
    NET_Toth_TypeError("Items_Add",0,"INTEGER",id);
    NET_Toth_TypeError("Items_Add",1,"STRING",item);
    if(NET_Toth_Controls[toString(id)]!="ComboBox" && NET_Toth_Controls[toString(id)]!="ListBox"){throwError("`Items_Add` Invalid Control: The Control type must be ComboBox/ListBox!")}
    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){
        throwError("`Items_Add` Invalid ID: The Control do not exist!")
    }else{
        callDLL(mydll,"AddItems","void",id,item)
    }
}
var Items_Remove=fn(id,item){
    NET_Toth_TypeError("Items_Remove",0,"INTEGER",id);
    NET_Toth_TypeError("Items_Remove",1,"STRING",item);
    if(NET_Toth_Controls[toString(id)]!="ComboBox" && NET_Toth_Controls[toString(id)]!="ListBox"){throwError("`Items_Remove` Invalid Control: The Control type must be ComboBox/ListBox!")}
    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){
        throwError("`Items_Remove` Invalid ID: The Control do not exist!")
    }else{
        callDLL(mydll,"RemoveItems","void",id,item)
    }
}
var Set_ItemID=fn(id,itemid){
    NET_Toth_TypeError("Set_ItemID",0,"INTEGER",id);
    NET_Toth_TypeError("Set_ItemID",1,"INTEGER",itemid);
    if(NET_Toth_Controls[toString(id)]!="ComboBox" && NET_Toth_Controls[toString(id)]!="ListBox"){throwError("`Set_ItemID` Invalid Control: The Control type must be ComboBox/ListBox!")}
    var items = split(callDLL(mydll,"GetItems","string",id),"\n")
    if(itemid> len(items)-1 || itemid<-1){
        throwError("`Set_ItemID` Invalid ID: The item do not exist!")
    }
    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){
        throwError("`Set_ItemID` Invalid ID: The Control do not exist!")
    }else{
        callDLL(mydll,"SetItem","void",id,itemid)
    }
}
var Get_Item=fn(id,itemid){
    NET_Toth_TypeError("Get_Item",0,"INTEGER",id);
    NET_Toth_TypeError("Get_Item",1,"INTEGER",itemid);
    if(NET_Toth_Controls[toString(id)]!="ComboBox" && NET_Toth_Controls[toString(id)]!="ListBox"){throwError("`Get_Item` Invalid Control: The Control type must be ComboBox/ListBox!")}
    var items = split(callDLL(mydll,"GetItems","string",id),"\n")
    if(itemid> len(items)-1 || itemid<-1){
        throwError("`Get_Item` Invalid ID: The item do not exist!")
    }    
    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){
        throwError("`Get_Item` Invalid ID: The Control do not exist!")
    }
    return items[itemid];
}

var Items_Length=fn(id){
    NET_Toth_TypeError("Get_Item",0,"INTEGER",id);
    if(NET_Toth_Controls[toString(id)]!="ComboBox" && NET_Toth_Controls[toString(id)]!="ListBox"){throwError("`Get_Item` Invalid Control: The Control type must be ComboBox/ListBox!")}
    var items = split(callDLL(mydll,"GetItems","string",id),"\n")
    return len(items);
}


var NET_Toth_canclick={};

var IsButtonDown=fn(id){
    
    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){throwError("`IsButtonDown("+id+")` Invalid ID: The Control do not exist!")}
    if(NET_Toth_Controls[toString(id)]!="Button"){throwError("`IsButtonDown` Invalid Control: The Control type must be Button!")}

    if(callDLL(mydll,"ControlIsDown","int", id) == 0){
        var NET_Toth_canclick =: hashEdit(NET_Toth_canclick,toString(id),true);
    }
    if(callDLL(mydll,"ControlIsDown","int", id) == 1 && NET_Toth_canclick[toString(id)]){
        var NET_Toth_canclick =: hashEdit(NET_Toth_canclick,toString(id),false);
        return true;
    }
    return false;
}


var IsCheckBoxChecked=fn(id){
    NET_Toth_TypeError("IsCheckBoxChecked",0,"INTEGER",id);
    if(typeof(NET_Toth_Controls[toString(id)])=="NULL"){throwError("`IsCheckBoxChecked` Invalid ID: The Control do not exist!")}
    if(NET_Toth_Controls[toString(id)]!="CheckBox"){throwError("`IsCheckBoxChecked` Invalid Control: The Control type must be CheckBox!")}
    return callDLL(mydll,"ControlIsChecked","bool",id);
}


var NET_Toth_firsttime=true
var Draw_Square=fn(x,y,width,height,color){
    NET_Toth_TypeError("Draw_Square",0,"INTEGER",x);
    NET_Toth_TypeError("Draw_Square",1,"INTEGER",y);
    NET_Toth_TypeError("Draw_Square",2,"INTEGER",width);
    NET_Toth_TypeError("Draw_Square",3,"INTEGER",height);
    NET_Toth_TypeError("Draw_Square",4,"ARRAY",color);
    if(typeof(color[0])!="INTEGER" || color[0]>255 || color[0]<0){throwError("`Draw_Square` Invalid Colorcode: must be INTEGER between 0 and 255. got="+ color[0])}
    if(typeof(color[1])!="INTEGER" || color[1]>255 || color[1]<0){throwError("`Draw_Square` Invalid Colorcode: must be INTEGER between 0 and 255. got="+ color[1])}
    if(typeof(color[2])!="INTEGER" || color[2]>255 || color[2]<0){throwError("`Draw_Square` Invalid Colorcode: must be INTEGER between 0 and 255. got="+ color[2])}
    if(NET_Toth_firsttime){
        var NET_Toth_firsttime=false;
        sleep(10);
    }
    if(callDLL(mydll,"IsFormRunning","int")==1){
        callDLL(mydll,"DrawSquare","void",x,y,width,height,color[0],color[1],color[2])
    }
}
var NET_Toth_firsttime2=true



var FormRunning=fn(){
    var v=callDLL(mydll,"IsFormRunning","int");
    if(v==1){return true;}
    return false;
}

var RunApp=fn(){
    callDLL(mydll,"RunApplication","void");
}






