

var binary_search=fn(arr,target){
    var low=0;
    var high=len(arr)-1;
    var returnvalue=-1;
    while(low<=high && returnvalue==-1){
        var mid=(low+high)/2;
        var guess= arr[mid];
        if(guess==target){
            var returnvalue=mid;

        }else{
        if(guess>target){
            var high=mid-1;
        }else{
            var low=mid+1;
        }
        }
    }
    return returnvalue;
}

println(binary_search([1, 3, 5, 7, 9] , 5))